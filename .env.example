# Cowrie
COWRIE_HOSTNAME=srv-db-prod-01
# Dionaea
DIONAEA_LISTEN=0.0.0.0
# Database (Week 2)
DB_BACKEND=sqlite           # sqlite | mongodb
SQLITE_PATH=./data/cadn.sqlite
# This MONGO_URI is for HOST-side tools (pipeline/responder/scripts run in the
# venv) — use localhost, which the loopback-published cadn-mongo answers on.
# The dockerized portal does NOT use this; it overrides MONGO_URI to the `mongo`
# service in deploy/docker-compose.portal.yml.
MONGO_URI=mongodb://cadn:CHANGE_ME@localhost:27017/cadn?authSource=admin
MONGO_PASS=CHANGE_ME
# Capture interface for the Scapy monitor and Zeek
CAPTURE_IFACE=eth0

# --- T-Pot integration (analysis-only mode) ---
# When T-Pot is the capture layer, point CADN's pipeline/responder at T-Pot's
# Cowrie/Dionaea JSON logs (adjust if your T-Pot stores data elsewhere).
COWRIE_LOG=/data/cowrie/log/cowrie.json
DIONAEA_LOG=/data/dionaea/log/dionaea.json
# Response on a honeypot host: keep OBSERVE mode (no firewall changes) so capture
# is not disrupted. Set to 1 only if you really want CADN to block/redirect.
RESPONDER_ENFORCE=0

# --- Week 5: management portal / API ---
# Admin login for the dashboard (set a strong password; auth is disabled if empty)
ADMIN_USER=admin
ADMIN_PASS=
# JWT signing key — generate with: python -c "import os;print(os.urandom(32).hex())"
JWT_SECRET=
JWT_TTL_MIN=120
# Real GeoIP heatmap: download MaxMind GeoLite2-City.mmdb into ./data/
GEOIP_DB=./data/GeoLite2-City.mmdb
# Response: deeper-honeypot redirect target port
REDIRECT_PORT=2222

# --- Week 5: alerting (leave blank to disable a channel; never faked) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=
SLACK_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
